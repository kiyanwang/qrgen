{
  "name": "qrgen",
  "version": "0.1.0",
  "description": "Generate customisable QR code PNGs from the command line or an interactive terminal UI",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "dev": "node src/cli.ts",
    "prepare": "npm run build",
    "docs:art": "node scripts/readme-art.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "commander": "15.0.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "typescript": "7.0.2"
  },
  "bin": {
    "qrgen": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  }
}
